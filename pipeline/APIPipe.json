{
	"name": "APIPipe",
	"properties": {
		"activities": [
			{
				"name": "ReadPublicJSON",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://jsonplaceholder.typicode.com/posts"
				}
			},
			{
				"name": "Set_Response",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "ReadPublicJSON",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "onlyjsoninterested",
					"value": {
						"value": "@activity('ReadPublicJSON').output.Response\r\n\r\n",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"onlyjsoninterested": {
				"type": "String"
			}
		},
		"annotations": []
	}
}